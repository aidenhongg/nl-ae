  "config_yaml_text": "# MVP eval config — Qwen2.5-7B-Instruct on MMLU + OpinionQA, greedy decoding.\n# Override anything from the CLI via `--set key.sub=value`.\n\ndataset:\n  enabled: [\"mmlu\"]\n  mmlu_split: \"test\"\n  # Override to a single subject for a 100-item pilot:\n  # nlae eval --config examples/mvp.yaml --set dataset.mmlu_subjects='[abstract_algebra]'\n  mmlu_subjects: null\n  mmlu_hf_id: \"cais/mmlu\"\n  mmlu_limit: null\n\n  opinionqa_source_dir: null\n  opinionqa_canonicalization: \"keep_all\"\n  opinionqa_subset_path: null\n\n  cache_dir: \"${ENV:HF_HOME:./hf_cache}\"\n  offline: false\n\n  templates_dir: \"./templates\"\n  templates_in_use: [\"mcq_flat_v1\"]\n  chat_enabled: true\n  pinned_chat_template_hash_path: \"./templates/pinned_chat_template.sha256\"\n\n  letter_token_variants: [\"bare\", \"leading_space\"]\n\nmodel:\n  hf_model_id: \"Qwen/Qwen2.5-7B-Instruct\"\n  hf_revision: null\n  cache_dir: \"${ENV:HF_HOME:./hf_cache}\"\n  attn_implementation: \"sdpa\"\n  device_map: \"cuda:0\"\n  default_max_new_tokens: 64\n  default_stop_strings: [\"\\n\\n\"]\n  pinned_chat_template_hash_path: \"./templates/pinned_chat_template.sha256\"\n\n  quantization:\n    kind: \"fp16\"\n    double_quant: true\n    compute_dtype: \"fp16\"\n    bnb_4bit_quant_storage: \"uint8\"\n    cpu_offload_layers: 0\n\n  hook_spec:\n    record_layers: null\n    position_policy: \"last_prompt_token\"\n    storage_dtype: \"fp16\"\n\ndecoding:\n  strategy: \"greedy\"\n  max_new_tokens: 64\n  stop_strings: [\"\\n\\n\"]\n  repetition_penalty: 1.0\n\nextractor:\n  extractor_id: \"regex_ladder\"\n  allow_majority_vote: false\n\neval:\n  plan:\n    template_ids: [\"mcq_flat_v1\"]\n    permutation_mode: \"seeded\"\n    permutations_per_item: 10\n  decoding:\n    decode_strategy: \"greedy\"\n    max_new_tokens: 64\n    scoring_math: \"full_vocab_softmax\"\n  batch_size: 1\n  log_every: 50\n  stdout_eta_every: 10\n  fail_fast: true\n  save_rendered_prompts: true\n  on_existing_dir: \"r